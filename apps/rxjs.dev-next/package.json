{
  "name": "rxjs.dev-next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "marbles:generate": "tsx tools/marbles/generate-diagrams.ts",
    "preapi:generate": "tsx tools/api-generator/clean.ts && pnpm run marbles:generate",
    "api:check": "tsc -p tsconfig.typedoc.json",
    "api:generate": "pnpm run api:check && typedoc && tsx tools/api-generator/index.ts",
    "dev": "pnpm run api:generate && vitepress dev",
    "build": "pnpm run api:generate && vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@swirly/parser": "^0.18.1",
    "@swirly/renderer-node": "^0.18.2",
    "@swirly/types": "^0.18.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.1",
    "@vueuse/core": "^14.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "shiki": "^1.0.0",
    "svgo": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.7.0",
    "typedoc": "^0.28.15",
    "typedoc-plugin-default-groups": "^1.0.2",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "~5.7.3",
    "vitepress": "^1.6.4"
  }
}

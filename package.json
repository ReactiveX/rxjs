{
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "analyze:bundles": "node scripts/analyze-bundles.mjs",
    "prepare-packages": "pnpm nx run-many -t build,lint,test:circular,dtslint,copy_common_package_files --exclude rxjs.dev",
    "release:beta": "node scripts/release/beta.mjs",
    "release:check": "node --test scripts/analyze-bundles.test.mjs scripts/check-package-docs.test.mjs scripts/check-release-coherence.test.mjs scripts/check-retired-products.test.mjs scripts/finalize-esm-package.test.mjs scripts/prerelease-adoption-lib.test.mjs scripts/release/beta.test.mjs scripts/release/conventional-commit.test.mjs scripts/security/check-osv-exceptions.test.mjs && node scripts/security/check-osv-exceptions.mjs && node scripts/check-package-docs.mjs && node scripts/check-release-coherence.mjs && node scripts/check-retired-products.mjs",
    "test:bundle-analysis": "node --test scripts/analyze-bundles.test.mjs",
    "test:workflows": "prettier --check .github/workflows/*.yml .github/actions/install-dependencies/action.yml .github/dependabot.yml",
    "test:kernel": "pnpm --filter rxjs run test:kernel",
    "test:lifecycle": "pnpm --filter @rxjs/observable-polyfill run test:lifecycle",
    "test:release:runtime": "pnpm --filter rxjs run test:release:runtime",
    "test:release:browsers": "pnpm --filter rxjs run test:release:browsers",
    "test:release:safari": "pnpm --filter rxjs run test:release:safari",
    "test:release:safari:desktop": "pnpm --filter rxjs run test:release:safari:desktop",
    "test:release:safari:ios": "pnpm --filter rxjs run test:release:safari:ios",
    "test:release:webpack": "pnpm --filter rxjs run test:release:webpack",
    "test:release:performance": "pnpm --filter rxjs run test:release:performance",
    "test:release:adoption": "node scripts/qualify-prerelease.mjs",
    "wpt:doctor": "node packages/observable-polyfill/test/wpt/cli.mjs doctor",
    "wpt:import": "node packages/observable-polyfill/test/wpt/cli.mjs import",
    "wpt:verify-import": "node packages/observable-polyfill/test/wpt/cli.mjs verify-import",
    "test:wpt": "node packages/observable-polyfill/test/wpt/cli.mjs test",
    "test:wpt:baseline": "node packages/observable-polyfill/test/wpt/cli.mjs test --baseline",
    "wpt:update-expectations": "node packages/observable-polyfill/test/wpt/cli.mjs update-expectations"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@playwright/test": "1.62.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "cz-conventional-changelog": "1.2.0",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "fast-check": "4.9.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "nx": "23.1.1",
    "prettier": "2.8.8",
    "ts-node": "^10.9.2",
    "tshy": "^1.11.0",
    "typescript": "~5.7.3",
    "vite": "6.4.3",
    "vitest": "^4.1.10",
    "webpack": "5.106.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "node scripts/release/validate-commit-message.mjs \"$HUSKY_GIT_PARAMS\""
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "(src|spec)/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,css,md}": "prettier --write"
  }
}

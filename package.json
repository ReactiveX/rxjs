{
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.13.0 || ^20.9.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare-packages": "pnpm nx test @rxjs/observable && pnpm nx run-many -t build,lint,test:circular,dtslint,copy_common_package_files --exclude rxjs.dev",
    "release": "node scripts/release.js",
    "wpt:doctor": "node packages/observable-polyfill/test/wpt/cli.mjs doctor",
    "wpt:import": "node packages/observable-polyfill/test/wpt/cli.mjs import",
    "wpt:verify-import": "node packages/observable-polyfill/test/wpt/cli.mjs verify-import",
    "test:wpt": "node packages/observable-polyfill/test/wpt/cli.mjs test",
    "test:wpt:baseline": "node packages/observable-polyfill/test/wpt/cli.mjs test --baseline",
    "test:wpt:strict": "node packages/observable-polyfill/test/wpt/cli.mjs test --strict",
    "wpt:update-expectations": "node packages/observable-polyfill/test/wpt/cli.mjs update-expectations"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "17.3.2",
    "@nx/js": "17.3.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "cz-conventional-changelog": "1.2.0",
    "esbuild": "0.19.11",
    "eslint": "^8.56.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "nx": "17.3.2",
    "prettier": "2.8.8",
    "ts-node": "^10.9.2",
    "tshy": "^1.11.0",
    "typescript": "~5.7.3",
    "validate-commit-msg": "2.14.0",
    "vitest": "^1.2.1",
    "yargs": "17.7.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "validate-commit-msg"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "(src|spec)/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,css,md}": "prettier --write"
  }
}

{
  "extends": "./tsconfig.esm.json",
  "compilerOptions": {
    "composite": true,
    "module": "es2015",
    "moduleResolution": "node10",
    "target": "ES2022",
    "removeComments": false,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "../dist/types",
    "emitDeclarationOnly": true
  }
}

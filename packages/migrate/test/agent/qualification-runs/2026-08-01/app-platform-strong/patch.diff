diff --git a/test/live-feed.test-source.ts b/test/live-feed.test-source.ts
index bc7da86..4a19aff 100644
--- a/test/live-feed.test-source.ts
+++ b/test/live-feed.test-source.ts
@@ -5,26 +5,36 @@ describe('shared application state', () => {
   it('PT-PLATFORM-SHARING shares one active producer and restarts after final unsubscribe', () => {
     const log: string[] = [];
     const feed = liveFeed(log);
-    const first = feed.subscribe();
-    const second = feed.subscribe();
-    first.unsubscribe();
-    second.unsubscribe();
-    feed.subscribe().unsubscribe();
+    const first = new AbortController();
+    const second = new AbortController();
+    feed.subscribe(null, { signal: first.signal });
+    feed.subscribe(null, { signal: second.signal });
+    first.abort('first observer cancelled');
+    second.abort('final observer cancelled');
+    const restarted = new AbortController();
+    feed.subscribe(null, { signal: restarted.signal });
+    restarted.abort('restarted observer cancelled');
     assert.deepEqual(log, ['start', 'stop', 'start', 'stop']);
   });
 
   it('PT-PLATFORM-SUBJECT preserves current and late-observer state', () => {
     status.next('ready');
     let observed = '';
-    status.subscribe((value) => (observed = value)).unsubscribe();
+    const observation = new AbortController();
+    status.subscribe((value) => (observed = value), { signal: observation.signal });
+    observation.abort('late observer cancelled');
     assert.equal(observed, 'ready');
   });
 
   it('PT-PLATFORM-REPEAT keeps refresh activation explicit', () => {
     const log: string[] = [];
     const feed = liveFeed(log);
-    feed.subscribe().unsubscribe();
-    feed.subscribe().unsubscribe();
+    const first = new AbortController();
+    feed.subscribe(null, { signal: first.signal });
+    first.abort('first refresh cancelled');
+    const second = new AbortController();
+    feed.subscribe(null, { signal: second.signal });
+    second.abort('second refresh cancelled');
     assert.deepEqual(log, ['start', 'stop', 'start', 'stop']);
   });
 });
